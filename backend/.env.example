# Copy this file to .env and fill in values. Never commit .env or paste real keys here.

# Comma-separated origins for the Next.js UI (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM (pick ONE provider; Groq is used first if GROQ_API_KEY is set) ---

# Groq (recommended for dev — fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
# If a model errors with "decommissioned", pick another id from the Groq console.

# xAI Grok (optional fallback if GROQ_API_KEY is empty): https://console.x.ai/
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4-1-fast-non-reasoning
# GROK_API_KEY=

# Student may generate on library miss (default: false). Keep false in real use —
# teachers publish via /teacher/generate + Approve first.
# STUDENT_ALLOW_GENERATE=false

# --- Verified content store (Neon Postgres via DBeaver) ---
# Teacher-approved lesson text + YouTube/summary media live in content_generation.*
# Prefer CONTENT_DATABASE_URL; DATABASE_URL is also accepted.
# CONTENT_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/neondb?sslmode=require
# Leave unset to use local SQLite under backend/data/ (dev fallback only).

# Cartoon AR images (default: Pollinations — no key required)
# AR_IMAGE_BASE=https://image.pollinations.ai/prompt

# Chapter gallery uploads (teacher Images tab). Unset = local /ar-media disk.
# S3_BUCKET=sci-path-demo-assets-dhanushi
# S3_LESSON_PREFIX=lesson-media
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Mastery score bands (0–100 dummy defaults until analytics confirms ranges)
# weak: score <= MASTERY_WEAK_MAX
# average: MASTERY_WEAK_MAX < score <= MASTERY_AVERAGE_MAX
# strong: score > MASTERY_AVERAGE_MAX
# MASTERY_WEAK_MAX=49
# MASTERY_AVERAGE_MAX=74

# --- Teacher route protection (same JWT_SECRET as User Management) ---
# off = local dev default (no JWT check). optional/required validate educator JWT on /teacher/* and /admin/*
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# LPE_TEACHER_AUTH=off
# LPE_SERVICE_KEY=
