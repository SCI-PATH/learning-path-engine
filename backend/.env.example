# Copy this file to .env and fill in values. Never commit .env or paste real keys here.

# Comma-separated origins for React (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# --- LLM (pick ONE provider; Groq is used first if GROQ_API_KEY is set) ---

# Groq (recommended for dev — fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# If a model errors with "decommissioned", pick another id from the Groq console.

# xAI Grok (optional fallback if GROQ_API_KEY is empty): https://console.x.ai/
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4-1-fast-non-reasoning
# GROK_API_KEY=
